#!/bin/sh
case $1 in
  */rustc-parallel-frontend | */clippy-driver | clippy-driver) exec "$@" ;;
esac
cache=${XDG_CACHE_HOME:-$HOME/.cache}/nanocode/build
if command -v shasum >/dev/null 2>&1; then
  sum="shasum -a 256"
else
  sum=sha256sum
fi
publish() {
  ln -sn "$1" "$2" 2>/dev/null || rm -rf "$1"
}
relocate() {
  from=$(printf '%s' "$1" | sed 's/[][\.*^$#]/\\&/g')
  to=$(printf '%s' "$2" | sed 's/[\&#]/\\&/g')
  sed "s#$from#$to#g"
}
clone() {
  [ -e "$2" ] && rm -f "$2"
  cp -c "$1" "$2" 2>/dev/null || cp "$1" "$2"
}
preprocess() {
  skip=
  for arg do
    shift
    if [ -n "$skip" ]; then
      skip=
      continue
    fi
    case $arg in
      -o) skip=1 && continue ;;
      -c) arg=-E ;;
    esac
    set -- "$@" "$arg"
  done
  "$@"
}
compile_c() {
  object= source= compile= previous= optimize=-O0
  for arg do
    case $previous in
      -o) object=$arg ;;
      -c) source=$arg ;;
    esac
    case $arg in
      -E | -M* | -o?* | @* | -) return ;;
      -c) compile=1 ;;
      -O*) optimize=$arg ;;
    esac
    previous=$arg
  done
  [ "$optimize" = -O0 ] && return
  case $source in
    "" | -*) return ;;
  esac
  [ -n "$compile" ] && [ -n "$object" ] || return
  expanded=$(mktemp "${TMPDIR:-/tmp}/cc-expanded.XXXXXX")
  if ! preprocess "$@" > "$expanded" 2>/dev/null; then
    rm -f "$expanded"
    return
  fi
  key=$( {
    echo nanocode-c-cache-1 "-ffile-prefix-map=<out>=."
    "$1" --version 2>&1
    pwd
    printf '%s\n' "$@" | grep -vxF -e -o -e "$object" | relocate "$OUT_DIR" "<out>"
    env | LC_ALL=C sort | grep -E '^(MACOSX_DEPLOYMENT_TARGET|SDKROOT|CPATH|C_INCLUDE_PATH|CPLUS_INCLUDE_PATH|OBJC_INCLUDE_PATH)='
    relocate "$OUT_DIR" "<out>" < "$expanded"
  } | $sum)
  rm -f "$expanded"
  entry=$cache/c/${key%% *}
  if [ -f "$entry.o" ]; then
    clone "$entry.o" "$object" || exit 1
    touch "$object"
    cat "$entry.err" >&2 2>/dev/null
    exit 0
  fi
  errors=$(mktemp "${TMPDIR:-/tmp}/cc-stderr.XXXXXX")
  "$@" "-ffile-prefix-map=$OUT_DIR=." 2> "$errors"
  status=$?
  cat "$errors" >&2
  if [ $status -eq 0 ]; then
    mkdir -p "$cache/c"
    staging=$(mktemp "$cache/c/.staging.XXXXXX")
    if cp "$errors" "$entry.err" && cp "$object" "$staging"; then
      mv -f "$staging" "$entry.o"
    else
      rm -f "$staging"
    fi
  fi
  rm -f "$errors"
  exit $status
}
case $1 in
  *rustc) ;;
  *)
    [ -n "${OUT_DIR:-}" ] && compile_c "$@"
    exec "$@"
    ;;
esac
unset CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR CARGO_BUILD_BUILD_DIR
stable() {
  stable_dir=
  listing=$(cd "$1" && find . | LC_ALL=C sort && find . -type f -exec $sum {} + | LC_ALL=C sort) || return
  key=$(printf '%s\n' "$listing" | $sum)
  stable_dir=$cache/out/${key%% *}
  if [ ! -e "$stable_dir" ]; then
    mkdir -p "$cache/out"
    staging=$(mktemp -d "$cache/out/.data.XXXXXX")
    if cp -cR "$1/." "$staging/" 2>/dev/null || cp -R "$1/." "$staging/"; then
      publish "$staging" "$stable_dir"
    else
      rm -rf "$staging"
    fi
  fi
}
if [ -n "${OUT_DIR:-}" ] && [ -d "$OUT_DIR" ]; then
  stable "$OUT_DIR"
  [ -e "$stable_dir" ] && OUT_DIR=$stable_dir && export OUT_DIR
fi
registry=${CARGO_HOME:-$HOME/.cargo}/registry/src/
unkeyed= out_dir= suffix= source= previous= keys=
for arg do
  shift
  keyed=$arg
  case $previous in
    -L)
      case $arg in
        native=*/build/*/out | all=*/build/*/out | crate=*/build/*/out)
          if [ -d "${arg#*=}" ]; then
            stable "${arg#*=}"
            [ -e "$stable_dir" ] && arg=${arg%%=*}=$stable_dir keyed=$arg
          fi
          ;;
        dependency=*) keyed=dependency= ;;
      esac
      ;;
    --out-dir) out_dir=$arg keyed= ;;
    --extern)
      case $arg in
        *=*)
          path=${arg#*=}
          memo=$path.nanocode-sha256
          if [ -f "$memo" ] && ! [ "$path" -nt "$memo" ]; then
            read -r identity < "$memo"
          elif identity=$($sum < "$path"); then
            identity=${identity%% *}
            printf '%s\n' "$identity" > "$memo.$$" && mv -f "$memo.$$" "$memo"
          else
            unkeyed=1
          fi
          keyed="${arg%%=*}=${path##*/} $identity"
          ;;
      esac
      ;;
    -C)
      case $arg in
        extra-filename=*) suffix=${arg#extra-filename=} ;;
      esac
      ;;
  esac
  case $arg in
    "$registry"*.rs) source=$arg ;;
    @*) unkeyed=1 ;;
  esac
  keys="$keys$keyed
"
  previous=$arg
  set -- "$@" "$arg"
done
if [ -n "$unkeyed" ] || [ -z "$source" ] || [ -z "$out_dir" ] || [ -z "$suffix" ]; then
  exec "$@"
fi
case $1 in
  */toolchains/*/bin/rustc)
    memo=$cache/rustc/$(printf '%s' "$1" | tr '/ ' '__')
    if [ -f "$memo" ] && ! [ "$1" -nt "$memo" ]; then
      IFS= read -r version < "$memo"
    else
      version=$("$1" -vV | $sum) || exec "$@"
      mkdir -p "$cache/rustc"
      printf '%s\n' "$version" > "$memo.$$" && mv -f "$memo.$$" "$memo"
    fi
    ;;
  *) version=$("$1" -vV | $sum) || exec "$@" ;;
esac
key=$( {
  echo nanocode-rustc-cache-3
  printf '%s\n%s' "$version" "$keys"
  env | LC_ALL=C sort | grep -E '^(CARGO_|OUT_DIR=|RUSTC_BOOTSTRAP=|MACOSX_DEPLOYMENT_TARGET=|SDKROOT=)' | grep -v '^CARGO_MAKEFLAGS='
} | $sum)
key=${key%% *}
entry=$cache/units/$key
same_environment() {
  [ -f "$1/env" ] || return 0
  while IFS= read -r line; do
    name=${line%%=*}
    case $name in
      "" | [0-9]* | *[!A-Za-z0-9_]*) return 1 ;;
    esac
    eval "defined=\${$name+1} current=\${$name-}"
    case $line in
      *=*) [ -n "$defined" ] && [ "$current" = "${line#*=}" ] || return 1 ;;
      *) [ -z "$defined" ] || return 1 ;;
    esac
  done < "$1/env"
}
if [ -f "$entry/out-dir" ] && same_environment "$entry"; then
  IFS= read -r cached_out < "$entry/out-dir"
  restored=
  for file in "$entry"/files/*; do
    name=${file##*/}
    case $name in
      *.d) relocate "$cached_out" "$out_dir" < "$file" > "$out_dir/$name" || exit 1 ;;
      *) clone "$file" "$out_dir/$name" || exit 1 && restored="$restored $name" ;;
    esac
  done
  (cd "$out_dir" && touch $restored) || exit 1
  [ -s "$entry/stderr" ] && relocate "$cached_out" "$out_dir" < "$entry/stderr" >&2
  exit 0
fi
stderr=$(mktemp "${TMPDIR:-/tmp}/rustc-stderr.XXXXXX")
status_file=$(mktemp "${TMPDIR:-/tmp}/rustc-status.XXXXXX")
trap 'rm -f "$stderr" "$status_file"' EXIT
{ { "$@"; echo $? > "$status_file"; } 2>&1 1>&3 3>&- | tee "$stderr" >&2; } 3>&1
status=$(cat "$status_file")
[ "$status" = 0 ] || exit "${status:-1}"
depinfo=
for file in "$out_dir"/*"$suffix".d; do
  [ -f "$file" ] && depinfo=$file
done
[ -n "$depinfo" ] || exit 0
while IFS= read -r line; do
  case $line in
    "#"* | "") ;;
    *:)
      case ${line%:} in
        "$registry"* | "$cache/out/"*) ;;
        *) exit 0 ;;
      esac
      ;;
  esac
done < "$depinfo"
mkdir -p "$cache/units"
staging=$(mktemp -d "$cache/units/.data.XXXXXX")
mkdir "$staging/files"
sed -n 's/^# env-dep:\([A-Za-z_][A-Za-z0-9_]*\).*/\1/p' "$depinfo" | sort -u | while IFS= read -r name; do
  eval "defined=\${$name+1} current=\${$name-}"
  case $current in
    *"
"*) echo multiline > "$staging/unsafe" ;;
  esac
  if [ -n "$defined" ]; then
    printf '%s=%s\n' "$name" "$current"
  else
    printf '%s\n' "$name"
  fi
done > "$staging/env"
if [ -f "$staging/unsafe" ]; then
  rm -rf "$staging"
  exit 0
fi
for file in "$out_dir"/*"$suffix"*; do
  case $file in
    *.nanocode-sha256) continue ;;
  esac
  [ -f "$file" ] || continue
  cp -c "$file" "$staging/files/" 2>/dev/null || cp "$file" "$staging/files/" || { rm -rf "$staging"; exit 0; }
done
cp "$stderr" "$staging/stderr"
printf '%s\n' "$out_dir" > "$staging/out-dir"
publish "$staging" "$entry"
exit 0
