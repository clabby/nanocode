#!/bin/sh
case $1 in
  */rustc-parallel-frontend | */clippy-driver | clippy-driver) exec "$@" ;;
esac
cache=${XDG_CACHE_HOME:-$HOME/.cache}/nanocode/build
source=${0%/*}/buildcache.rs
checksum=$(cksum < "$source") || exec "$@"
helper=$cache/bin/buildcache-${checksum%% *}
[ -x "$helper" ] && exec "$helper" "$@"
[ -f "$helper.failed" ] && exec "$@"
case $1 in
  *rustc)
    mkdir -p "$cache/bin" || exec "$@"
    if [ -d "$helper.lock" ]; then
      { read -r builder < "$helper.lock/pid"; } 2>/dev/null
      kill -0 "${builder:-0}" 2>/dev/null || rm -rf "$helper.lock"
    fi
    if mkdir "$helper.lock" 2>/dev/null; then
      echo $$ > "$helper.lock/pid"
      (
        sh -c 'echo $PPID' > "$helper.lock/pid"
        if env -u CARGO_MAKEFLAGS -u MAKEFLAGS -u MFLAGS "$1" --edition 2024 -C opt-level=2 -o "$helper.$$" "$source"; then
          mv -f "$helper.$$" "$helper"
        else
          touch "$helper.failed"
        fi
        rm -f "$helper.$$"
        rm -rf "$helper.lock"
      ) < /dev/null > /dev/null 2>&1 &
    fi
    ;;
esac
exec "$@"
